# Variables del compose de desarrollo. Copia a deploy/.env (ignorado por git) o ejecuta
# `make dev-env`, que genera valores aleatorios para las variables vacías.
# Nunca pongas aquí valores reales.

# PostgreSQL: superusuario (solo init) y roles de la app (ver deploy/postgres/init).
POSTGRES_PASSWORD=
SEGUROS_MIGRATOR_PASSWORD=
SEGUROS_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Valkey
VALKEY_PASSWORD=

# Keycloak: admin de arranque, secreto del cliente BFF y contraseña de los usuarios de prueba del realm.
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_BFF_CLIENT_SECRET=
KC_TEST_USER_PASSWORD=

# SeaweedFS S3
S3_ACCESS_KEY=
S3_SECRET_KEY=
